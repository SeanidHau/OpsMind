# 应用运行环境与日志级别。
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL：本地开发数据库；启用持久化运行归档时必须启动该服务。
POSTGRES_DB=opsmind
POSTGRES_USER=opsmind
POSTGRES_PASSWORD=opsmind_dev_only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://opsmind:opsmind_dev_only@127.0.0.1:5432/opsmind
# memory 保持本地零依赖；postgres 在服务启动时创建 run_snapshots 表。
RUN_ARCHIVE_BACKEND=memory

# Qdrant 本地服务地址。
QDRANT_URL=http://127.0.0.1:6333

# 模型供应商可通过环境变量切换；当前支持 openai 和 anthropic。
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# LangSmith 默认关闭；接入评测时再启用。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=opsmind-dev
