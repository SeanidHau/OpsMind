# 应用运行环境与日志级别。
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL：仅用于本地开发，实际密码写入 .env。
POSTGRES_DB=opsmind
POSTGRES_USER=opsmind
POSTGRES_PASSWORD=opsmind_dev_only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://opsmind:opsmind_dev_only@127.0.0.1:5432/opsmind

# Qdrant 本地服务地址。
QDRANT_URL=http://127.0.0.1:6333

# 模型供应商后续可通过环境变量切换。
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# LangSmith 默认关闭；接入评测时再启用。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=opsmind-dev
